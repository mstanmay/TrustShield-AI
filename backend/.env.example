# ── Application ────────────────────────────────────────────────────────────
APP_NAME=SEBI Fraud Detection Backend
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sebi:sebi_secret@localhost:5432/sebi_fraud
DATABASE_SYNC_URL=postgresql://sebi:sebi_secret@localhost:5432/sebi_fraud

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Object Storage (MinIO) ───────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=sebi-artifacts

# ── JWT Auth ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev_secret_change_in_production_32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Anthropic LLM ────────────────────────────────────────────────────────
# Leave empty to use FallbackLLMProvider (template-based explanations)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-4-20250514

# ── Agent Weights ─────────────────────────────────────────────────────────
WEIGHT_DEEPFAKE=0.30
WEIGHT_VOICE=0.20
WEIGHT_DOCUMENT=0.25
WEIGHT_PHISHING=0.25

# ── Feature Flags ─────────────────────────────────────────────────────────
ENABLE_MALWARE_SCAN=false
ENABLE_VIRUSTOTAL=false
VIRUSTOTAL_API_KEY=

# ── OpenTelemetry ─────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=sebi-fraud-detection
