# ── Enterprise Production Environment Configuration ──────────────────────

APP_NAME="SEBI AI Trust Platform"
APP_VERSION="2.4.0-enterprise"
ENVIRONMENT="production"
DEBUG=false
LOG_LEVEL="INFO"

# ── Security & Authentication ────────────────────────────────────────────────
SECRET_KEY="SEBI_ENTERPRISE_PRODUCTION_JWT_SECRET_CHANGE_IN_PROD_MIN_64_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── PostgreSQL Database Tier ────────────────────────────────────────────────
POSTGRES_USER=sebi_admin
POSTGRES_PASSWORD=SEBI_Super_Secure_Prod_DB_Pass_2026!
POSTGRES_DB=sebi_fraud_prod
DATABASE_URL="postgresql+asyncpg://sebi_admin:SEBI_Super_Secure_Prod_DB_Pass_2026!@postgres:5432/sebi_fraud_prod"
DATABASE_SYNC_URL="postgresql://sebi_admin:SEBI_Super_Secure_Prod_DB_Pass_2026!@postgres:5432/sebi_fraud_prod"

# ── Redis Cache & Broker Tier ──────────────────────────────────────────────
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/1"
CELERY_RESULT_BACKEND="redis://redis:6379/2"

# ── MinIO S3 Object Storage Tier ───────────────────────────────────────────
S3_ENDPOINT_URL="http://minio:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="sebi-artifacts"

# ── Qdrant Vector Database ────────────────────────────────────────────────
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""

# ── MLflow Tracking & Registry ─────────────────────────────────────────────
MLFLOW_TRACKING_URI="http://mlflow:5000"
MLFLOW_EXPERIMENT_NAME="sebi_fraud_detection_models_prod"

# ── RabbitMQ Event Bus ────────────────────────────────────────────────────
RABBITMQ_URL="amqp://guest:guest@rabbitmq:5672/"

# ── Neo4j Fraud Intelligence Graph ───────────────────────────────────────
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="sebi_graph_secret"

# ── Threat Intelligence API Keys ──────────────────────────────────────────
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""

# ── OpenTelemetry & Jaeger Distributed Tracing ─────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME="sebi-fraud-detection-prod"
OTEL_EXPORTER_ENDPOINT="http://jaeger:4317"
